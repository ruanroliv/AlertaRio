  "components": {
    "schemas": {
      "CallStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Em análise",
              "Concluído"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CallStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "NewCall": {
        "properties": {
          "community_id": {
            "type": "string",
            "pattern": "^AR-00[1-5]$",
            "title": "Community Id"
          },
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 8,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "community_id",
          "text"
        ],
        "title": "NewCall"
      },
      "Notification": {
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "title": "Phone"
          },
          "channel": {
            "type": "string",
            "enum": [
              "sms",
              "whatsapp"
            ],
            "title": "Channel"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": true
          },
          "confirm_send": {
            "type": "boolean",
            "title": "Confirm Send",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "phone",
          "channel"
        ],
        "title": "Notification"
      },
      "Reading": {
        "properties": {
          "sensor_id": {
            "type": "string",
            "pattern": "^AR-00[1-5]$",
            "title": "Sensor Id"
          },
          "water_level_cm": {
            "type": "number",
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Water Level Cm"
          },
          "soil_moisture_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Soil Moisture Pct"
          },
          "rainfall_mm": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Rainfall Mm"
          },
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Measured At"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": true
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "device_uptime_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Uptime Ms"
          },
          "raw_sensor": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Sensor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sensor_id",
          "water_level_cm",
          "soil_moisture_pct",
          "rainfall_mm",
          "measured_at"
        ],
        "title": "Reading"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}