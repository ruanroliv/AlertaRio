# Local HTTP only. Production must use HTTPS termination and APP_ENV=production.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
ENABLE_REAL_MESSAGES=false
MESSAGE_TEST_RECIPIENTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Base fictícia criada uma vez no desenvolvimento (nunca em produção).
DEMO_DATA=true
